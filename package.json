{
  "name": "kitchen-planner",
  "private": true,
  "version": "0.0.4",
  "description": "부엌 셀프 설계 — 쿠지알러 부엌 파라메트릭 원본 · 자동 배치 · 실사 렌더",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "data": "python -I tools/build_kitchen_data.py",
    "check": "tsc --noEmit && node tools/check.mjs",
    "glb": "node tools/compress_glb.mjs public/props",
    "profiles": "python -I tools/build_profiles.py && npx vite-node tools/probe-profiles.ts"
  }
}
